exports[`AreaChart > respeita dimensões e accent customizados 1`] = `"<svg role="img" aria-label="Area chart" viewBox="0 0 600 200" width="600" height="200" preserveAspectRatio="xMidYMid meet" style="display:block"><path d="M 0 200 L 120 133.33333333333334 L 240 166.66666666666669 L 360 66.66666666666669 L 480 100 L 600 0 L 600 200 L 0 200 Z" fill="var(--group-precos)" fill-opacity="0.25" stroke="none"></path><path d="M 0 200 L 120 133.33333333333334 L 240 166.66666666666669 L 360 66.66666666666669 L 480 100 L 600 0" fill="none" stroke="var(--group-precos)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path></svg>"`;
