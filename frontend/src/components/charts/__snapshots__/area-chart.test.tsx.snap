exports[`AreaChart > lida com ponto único desenhando linha plana sem área 1`] = `"<svg role="img" aria-label="Area chart" viewBox="0 0 360 120" width="360" height="120" preserveAspectRatio="xMidYMid meet" style="display:block"><line x1="0" y1="60" x2="360" y2="60" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round"></line></svg>"`;

