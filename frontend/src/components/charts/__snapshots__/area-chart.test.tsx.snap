exports[`AreaChart > omite a linha quando showLine=false 1`] = `"<svg role="img" aria-label="Area chart" viewBox="0 0 360 120" width="360" height="120" preserveAspectRatio="xMidYMid meet" style="display:block"><path d="M 0 120 L 120 80 L 240 40 L 360 0 L 360 120 L 0 120 Z" fill="var(--accent)" fill-opacity="0.4" stroke="none"></path></svg>"`;

