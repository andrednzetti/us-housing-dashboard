exports[`LedgerFilter > marca a pill correta quando active=taxas 1`] = `"<div role="tablist" aria-label="Filtro de grupo do Ledger" style="display:flex;gap:var(--space-1);flex-wrap:wrap"><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">TODOS</button><button role="tab" type="button" aria-selected="true" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:var(--bg-band);color:var(--ink-inverse);border:0.5px solid var(--bg-band)">TAXAS</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">PREÇOS</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">OFERTA</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">SENTIMENTO</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">MACRO</button></div>"`;

