exports[`Ledger > renderiza section com header completo + 23 rows quando filter=all 1`] = `"<section style="background:var(--bg-panel);border:var(--border-card)" aria-labelledby="ledger-title"><div style="display:flex;justify-content:space-between;align-items:flex-end;padding:var(--space-6) var(--space-7) var(--space-4);border-bottom:var(--border-card);gap:var(--space-4);flex-wrap:wrap"><div><div style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:var(--ls-label);color:var(--ink-mute);text-transform:uppercase">Discriminação · 23 itens</div><h2 id="ledger-title" style="font-family:var(--font-serif);font-size:1.5rem;font-weight:500;letter-spacing:var(--ls-card);margin:var(--space-1) 0 0">Os 23 indicadores</h2></div><div role="tablist" aria-label="Filtro de grupo do Ledger" style="display:flex;gap:var(--space-1);flex-wrap:wrap"><button role="tab" type="button" aria-selected="true" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:var(--bg-band);color:var(--ink-inverse);border:0.5px solid var(--bg-band)">TODOS</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">TAXAS</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">PREÇOS</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">OFERTA</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">SENTIMENTO</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.08em;padding:5px 11px;cursor:pointer;text-transform:uppercase;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">MACRO</button></div></div><div role="row" style="display:grid;grid-template-columns:16px 110px 1fr 110px 130px 100px;gap:14px;padding:10px 22px;background:var(--rule-soft);font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:0.16em;color:var(--ink-mute);text-transform:uppercase;border-bottom:var(--border-card)"><span aria-hidden="true"></span><span role="columnheader">Código</span><span role="columnheader">Indicador</span><span role="columnheader" style="text-align:right">Valor</span><span role="columnheader" style="text-align:right">Variação</span><span role="columnheader">Tendência 52s</span></div><button type="button" style="display:grid;grid-template-columns:16px 110px 1fr 110px 130px 100px;gap:14px;align-items:center;padding:12px 22px;border-bottom:0.5px solid var(--rule);background:transparent;border:0;border-bottom-width:0.5px;border-bottom-style:solid;border-bottom-color:var(--rule);width:100%;text-align:left;cursor:pointer;font-family:var(--font-sans);color:var(--ink);margin:0"><span style="width:6px;height:6px;border-radius:50%;background:var(--group-taxas);display:inli