// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`LedgerRow > aplica bg --rule-soft + aria-current quando isSelected=true 1`] = `"<button type="button" aria-current="true" style="display:grid;grid-template-columns:16px 110px 1fr 110px 130px 100px;gap:14px;align-items:center;padding:12px 22px;border-bottom:0.5px solid var(--rule);background:var(--rule-soft);border:0;border-bottom-width:0.5px;border-bottom-style:solid;border-bottom-color:var(--rule);width:100%;text-align:left;cursor:pointer;font-family:var(--font-sans);color:var(--ink);margin:0"><span style="width:6px;height:6px;border-radius:50%;background:var(--group-taxas);display:inline-block" aria-hidden="true"></span><span style="font-family:var(--font-mono);font-size:var(--fs-label);color:var(--ink-mute);letter-spacing:0.12em">MOCK</span><span style="font-family:var(--font-serif);font-size:var(--fs-body);color:var(--ink)">Mock Indicator</span><span style="font-family:var(--font-mono);font-size:var(--fs-table);font-weight:500;color:var(--ink);text-align:right">6,85%</span><span style="font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;text-align:right;white-space:nowrap;color:var(--pos)">+0,12pp<span style="color:var(--ink-mute);margin-left:var(--space-1);font-weight:400">· sem</span></span><svg role="img" aria-label="Tendência 52 semanas de Mock Indicator" viewBox="0 0 100 18" width="100" height="18" preserveAspectRatio="xMidYMid meet" style="display:block;overflow:visible"><path d="M 0 18 L 25 12.85714285714287 L 50 7.714285714285694 L 75 2.571428571428564 L 100 0" fill="none" stroke="var(--pos)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"></path></svg></button>"`;

exports[`LedgerRow > delta zero renderiza ± com cor neutral 1`] = `"<button type="button" style="display:grid;grid-template-columns:16px 110px 1fr 110px 130px 100px;gap:14px;align-items:center;padding:12px 22px;border-bottom:0.5px solid var(--rule);background:transparent;border:0;border-bottom-width:0.5px;border-bottom-style:solid;border-bottom-color:var(--rule);width:100%;text-align:left;cursor:pointer;font-family:var(--font-sans);color:var(--ink);margin:0"><span style="width:6px;height:6px;border-radius:50%;background:var(--group-sentimento);display:inline-block" aria-hidden="true"></span><span style="font-family:var(--font-mono);font-size:var(--fs-label);color:var(--ink-mute);letter-spacing:0.12em">NAHB HMI</span><span style="font-family:var(--font-serif);font-size:var(--fs-body);color:var(--ink)">NAHB Housing Market Index</span><span style="font-family:var(--font-mono);font-size:var(--fs-table);font-weight:500;color:var(--ink);text-align:right">38</span><span style="font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;text-align:right;white-space:nowrap;color:var(--ink-mute)">±0,0pts<span style="color:var(--ink-mute);margin-left:var(--space-1);font-weight:400">· mês</span></span><svg role="img" aria-label="Tendência 52 semanas de NAHB Housing Market Index" viewBox="0 0 100 18" width="100" height="18" preserveAspectRatio="xMidYMid meet" style="display:block;overflow:visible"><path d="M 0 18 L 25 12.85714285714287 L 50 7.714285714285694 L 75 2.571428571428564 L 100 0" fill="none" stroke="var(--ink-mute)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"></path></svg></button>"`;

exports[`LedgerRow > renderiza row típica (delta positivo, upIsBad=false → cor pos) 1`] = `"<button type="button" style="display:grid;grid-template-columns:16px 110px 1fr 110px 130px 100px;gap:14px;align-items:center;padding:12px 22px;border-bottom:0.5px solid var(--rule);background:transparent;border:0;border-bottom-width:0.5px;border-bottom-style:solid;border-bottom-color:var(--rule);width:100%;text-align:left;cursor:pointer;font-family:var(--font-sans);color:var(--ink);margin:0"><span style="width:6px;height:6px;border-radius:50%;background:var(--group-precos);display:inline-block" aria-hidden="true"></span><span style="font-family:var(--font-mono);font-size:var(--fs-label);color:var(--ink-mute);letter-spacing:0.12em">CASE-SHILLER</span><span style="font-family:var(--font-serif);font-size:var(--fs-body);color:var(--ink)">Case-Shiller Nacional</span><span style="font-family:var(--font-mono);font-size:var(--fs-table);font-weight:500;color:var(--ink);text-align:right">332,1</span><span style="font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;text-align:right;white-space:nowrap;color:var(--pos)">+0,66% a.a.<span style="color:var(--ink-mute);margin-left:var(--space-1);font-weight:400">· 12m</span></span><svg role="img" aria-label="Tendência 52 semanas de Case-Shiller Nacional" viewBox="0 0 100 18" width="100" height="18" preserveAspectRatio="xMidYMid meet" style="display:block;overflow:visible"><path d="M 0 18 L 25 12.85714285714287 L 50 7.714285714285694 L 75 2.571428571428564 L 100 0" fill="none" stroke="var(--pos)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"></path></svg></button>"`;

exports[`LedgerRow > renderiza upIsBad=true com delta positivo → cor neg (sparkline + delta) 1`] = `"<button type="button" style="display:grid;grid-template-columns:16px 110px 1fr 110px 130px 100px;gap:14px;align-items:center;padding:12px 22px;border-bottom:0.5px solid var(--rule);background:transparent;border:0;border-bottom-width:0.5px;border-bottom-style:solid;border-bottom-color:var(--rule);width:100%;text-align:left;cursor:pointer;font-family:var(--font-sans);color:var(--ink);margin:0"><span style="width:6px;height:6px;border-radius:50%;background:var(--group-taxas);display:inline-block" aria-hidden="true"></span><span style="font-family:var(--font-mono);font-size:var(--fs-label);color:var(--ink-mute);letter-spacing:0.12em">30Y MORTGAGE</span><span style="font-family:var(--font-serif);font-size:var(--fs-body);color:var(--ink)">Mortgage 30Y Fixa</span><span style="font-family:var(--font-mono);font-size:var(--fs-table);font-weight:500;color:var(--ink);text-align:right">6,30%</span><span style="font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;text-align:right;white-space:nowrap;color:var(--neg)">+0,07pp<span style="color:var(--ink-mute);margin-left:var(--space-1);font-weight:400">· sem</span></span><svg role="img" aria-label="Tendência 52 semanas de Mortgage 30Y Fixa" viewBox="0 0 100 18" width="100" height="18" preserveAspectRatio="xMidYMid meet" style="display:block;overflow:visible"><path d="M 0 18 L 25 12.85714285714287 L 50 7.714285714285694 L 75 2.571428571428564 L 100 0" fill="none" stroke="var(--neg)" stroke-width="1.1" stroke-linejoin="round" stroke-linecap="round"></path></svg></button>"`;
