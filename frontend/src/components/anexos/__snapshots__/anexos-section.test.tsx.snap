// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AnexosSection > renderiza ambos os panels lado a lado 1`] = `"<section style="display:grid;grid-template-columns:minmax(0, 1fr) minmax(0, 1fr);gap:var(--space-7);align-items:start" aria-label="Anexos do boletim — regiões e metros"><div style="background:var(--bg-panel);border:var(--border-card);padding:var(--space-7)" aria-labelledby="regioes-title"><div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:var(--space-5);padding-bottom:var(--space-3);border-bottom:var(--border-card)"><div><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);color:var(--ink-mute);text-transform:uppercase">Anexo I</div><h3 id="regioes-title" style="font-family:var(--font-serif);font-size:1.125rem;font-weight:500;margin:2px 0 0">Por região censitária</h3></div><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">2 regiões</span></div><ol style="list-style:none;margin:0;padding:0"><li style="display:grid;grid-template-columns:110px 1fr 90px 70px;gap:14px;align-items:center;padding:14px 0;border-bottom:var(--border-card)"><span style="font-family:var(--font-serif);font-size:0.9375rem;color:var(--ink);display:flex;align-items:center;gap:6px">Northeast</span><div style="width:100%;height:5px;background:var(--rule-soft);border-radius:2.5px;overflow:hidden" role="progressbar" aria-label="Vendas em Northeast: 612 mil unidades" aria-valuenow="612" aria-valuemin="0" aria-valuemax="2000"><div style="width:30.60%;height:100%;background:var(--ink)"></div></div><span style="font-family:var(--font-mono);font-size:0.75rem;text-align:right;color:var(--ink)">$478k</span><span style="font-family:var(--font-mono);font-size:0.6875rem;text-align:right;font-weight:500;color:var(--pos)">+3,8%</span></li><li style="display:grid;grid-template-columns:110px 1fr 90px 70px;gap:14px;align-items:center;padding:14px 0;border-bottom:none"><span style="font-family:var(--font-serif);font-size:0.9375rem;color:var(--ink);display:flex;align-items:center;gap:6px">Midwest<span style="width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0" aria-hidden="true"></span></span><div style="width:100%;height:5px;background:var(--rule-soft);border-radius:2.5px;overflow:hidden" role="progressbar" aria-label="Vendas em Midwest: 1041 mil unidades" aria-valuenow="1041" aria-valuemin="0" aria-valuemax="2000"><div style="width:52.05%;height:100%;background:var(--accent)"></div></div><span style="font-family:var(--font-mono);font-size:0.75rem;text-align:right;color:var(--ink)">$312k</span><span style="font-family:var(--font-mono);font-size:0.6875rem;text-align:right;font-weight:500;color:var(--pos)">+4,2%</span></li></ol></div><div style="background:var(--bg-panel);border:var(--border-card);padding:var(--space-7)" aria-labelledby="metros-title"><div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:var(--space-5);padding-bottom:var(--space-3);border-bottom:var(--border-card)"><div><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);color:var(--ink-mute);text-transform:uppercase">Anexo II</div><h3 id="metros-title" style="font-family:var(--font-serif);font-size:1.125rem;font-weight:500;margin:2px 0 0">Top metros · Sun Belt</h3></div><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">2 cidades</span></div><ol style="list-style:none;margin:0;padding:0"><li style="display:grid;grid-template-columns:20px 1fr 80px 60px 50px;gap:12px;align-items:center;padding:11px 0;border-bottom:0.5px solid var(--rule-soft)"><span style="font-family:var(--font-mono);font-size:var(--fs-label-l);color:var(--ink-mute)">01</span><span style="font-family:var(--font-serif);font-size:var(--fs-body);display:flex;align-items:center;gap:6px;color:var(--ink)">Tampa, FL<span style="width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0" aria-hidden="true"></span></span><span style="font-family:var(--font-mono);font-size:0.75rem;text-align:right;color:var(--ink)">$392k</span><span style="font-family:var(--font-mono);font-size:0.6875rem;text-align:right;font-weight:500;color:var(--pos)">+6,8%</span><span style="font-family:var(--font-mono);font-size:0.6875rem;color:var(--ink-mute);text-align:right">28d</span></li><li style="display:grid;grid-template-columns:20px 1fr 80px 60px 50px;gap:12px;align-items:center;padding:11px 0;border-bottom:none"><span style="font-family:var(--font-mono);font-size:var(--fs-label-l);color:var(--ink-mute)">02</span><span style="font-family:var(--font-serif);font-size:var(--fs-body);display:flex;align-items:center;gap:6px;color:var(--ink)">Charlotte, NC<span style="width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0" aria-hidden="true"></span></span><span style="font-family:var(--font-mono);font-size:0.75rem;text-align:right;color:var(--ink)">$385k</span><span style="font-family:var(--font-mono);font-size:0.6875rem;text-align:right;font-weight:500;color:var(--pos)">+5,4%</span><span style="font-family:var(--font-mono);font-size:0.6875rem;color:var(--ink-mute);text-align:right">32d</span></li></ol></div></section>"`;
