// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MetrosPanel > lida com metros vazio (header sem rows) 1`] = `"<div style="background:var(--bg-panel);border:var(--border-card);padding:var(--space-7)" aria-labelledby="metros-title"><div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:var(--space-5);padding-bottom:var(--space-3);border-bottom:var(--border-card)"><div><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);color:var(--ink-mute);text-transform:uppercase">Anexo II</div><h3 id="metros-title" style="font-family:var(--font-serif);font-size:1.125rem;font-weight:500;margin:2px 0 0">Top metros · Sun Belt</h3></div><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">0 cidades</span></div><ol style="list-style:none;margin:0;padding:0"></ol></div>"`;

exports[`MetrosPanel > renderiza Anexo II com 8 metros (default topN=8) 1`] = `"<div style="background:var(--bg-panel);border:var(--border-card);padding:var(--space-7)" aria-labelledby="metros-title"><div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:var(--space-5);padding-bottom:var(--space-3);border-bottom:var(--border-card)"><div><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);color:var(--ink-mute);text-transform:uppercase">Anexo II</div><h3 id="metros-title" style="font-family:var(--font-serif);font-size:1.125rem;font-weight:500;margin:2px 0 0">Top metros · Sun Belt</h3></div><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">8 cidades</span></div><ol style="list-style:none;margin:0;padding:0"><li style="display:grid;grid-template-columns:20px 1fr 80px 60px 50px;gap:12px;align-items:center;padding:11px 0;border-bottom:0.5px solid var(--rule-soft)"><span style="font-family:var(--font-mono);font-size:var(--fs-label-l);color:var(--ink-mute)">01</span><span style="font-family:var(--font-serif);font-size:var(--fs-body);display:flex;align-items:center;gap:6px;color:var(--ink)">Tampa, FL<span style="width:5px;height:5px;border-radius:50%;background:var(--accent);flex-shrink:0" aria-hidden="true"></span></span><span style="font-family:var(--font-mono);font-size:0.75rem;text-align:right;color:var(--ink)">$392k</span><span style="font-family:var(--font-mono);font-size:0.6875rem;text-align:right;font-weight:500;color:var(--pos)">+6,8%</span><span style="font-family:var(--font-mono);font-size:0.6875rem;color:var(--ink-mute);text-align:right">28d</span></li><li style="display:grid;grid-template-columns:20px 1fr 80px 60px 50px;gap:12px;align-items:center;