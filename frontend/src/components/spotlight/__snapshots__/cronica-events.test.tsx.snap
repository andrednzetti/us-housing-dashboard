// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CronicaEvents > 1 único evento: dot accent, sem connector 1`] = `"<div style="background:var(--bg-panel);border:var(--border-card);padding:var(--space-6)" aria-labelledby="cronica-title"><div style="display:flex;justify-content:space-between;align-items:baseline;padding-bottom:var(--space-3);margin-bottom:var(--space-4);border-bottom:var(--border-card)"><span id="cronica-title" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:var(--ls-label);color:var(--ink-mute);text-transform:uppercase">Crônica da semana</span><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">1</span></div><ol style="list-style:none;margin:0;padding:0"><li style="position:relative;padding-left:22px;padding-bottom:0"><span style="position:absolute;left:4px;top:5px;width:7px;height:7px;border-radius:50%;background:var(--accent);border:1.5px solid var(--accent);box-sizing:border-box" aria-hidden="true"></span><div style="display:flex;gap:var(--space-2);align-items:baseline;margin-bottom:3px"><span style="font-family:var(--font-mono);font-size:var(--fs-label-l);color:var(--ink-mute);letter-spacing:0.06em">05.MAI</span><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">FED</span></div><p style="margin:0;font-family:var(--font-serif);font-size:0.8125rem;line-height:1.5;color:var(--ink)">FOMC mantém taxa em 4,25-4,50%. Tom dovish.</p></li></ol></div>"`;

exports[`CronicaEvents > renderiza empty state quando events=[] 1`] = `"<div style="background:var(--bg-panel);border:var(--border-card);padding:var(--space-6)" aria-labelledby="cronica-title"><div style="display:flex;justify-content:space-between;align-items:baseline;padding-bottom:var(--space-3);margin-bottom:var(--space-4);border-bottom:var(--border-card)"><span id="cronica-title" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:var(--ls-label);color:var(--ink-mute);text-transform:uppercase">Crônica da semana</span><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">0</span></div><p style="margin:0;font-family:var(--font-serif);font-style:italic;font-size:var(--fs-body);color:var(--ink-mute)">Nenhum evento esta semana.</p></div>"`;

exports[`CronicaEvents > renderiza timeline com 3 events (1º em accent, demais com rule) 1`] = `"<div style="background:var(--bg-panel);border:var(--border-card);padding:var(--space-6)" aria-labelledby="cronica-title"><div style="display:flex;justify-content:space-between;align-items:baseline;padding-bottom:var(--space-3);margin-bottom:var(--space-4);border-bottom:var(--border-card)"><span id="cronica-title" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:var(--ls-label);color:var(--ink-mute);text-transform:uppercase">Crônica da semana</span><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">3</span></div><ol style="list-style:none;margin:0;padding:0"><li style="position:relative;padding-left:22px;padding-bottom:var(--space-4)"><span style="position:absolute;left:4px;top:5px;width:7px;height:7px;border-radius:50%;background:var(--accent);border:1.5px solid var(--accent);box-sizing:border-box" aria-hidden="true"></span><span style="position:absolute;left:7px;top:14px;bottom:-2px;width:0.5px;background:var(--rule)" aria-hidden="true"></span><div style="display:flex;gap:var(--space-2);align-items:baseline;margin-bottom:3px"><span style="font-family:var(--font-mono);font-size:var(--fs-label-l);color:var(--ink-mute);letter-spacing:0.06em">05.MAI</span><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">FED</span></div><p style="margin:0;font-family:var(--font-serif);font-size:0.8125rem;line-height:1.5;color:var(--ink)">FOMC mantém taxa em 4,25-4,50%. Tom dovish.</p></li><li style="position:relative;padding-left:22px;padding-bottom:var(--space-4)"><span style="position:absolute;left:4px;top:5px;width:7px;height:7px;border-radius:50%;background:var(--bg-panel);border:1.5px solid var(--rule);box-sizing:border-box" aria-hidden="true"></span><span style="position:absolute;left:7px;top:14px;bottom:-2px;width:0.5px;background:var(--rule)" aria-hidden="true"></span><div style="display:flex;gap:var(--space-2);align-items:baseline;margin-bottom:3px"><span style="font-family:var(--font-mono);font-size:var(--fs-label-l);color:var(--ink-mute);letter-spacing:0.06em">02.MAI</span><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">DADO</span></div><p style="margin:0;font-family:var(--font-serif);font-size:0.8125rem;line-height:1.5;color:var(--ink)">Mortgage apps sobem 4,2% s/s.</p></li><li style="position:relative;padding-left:22px;padding-bottom:0"><span style="position:absolute;left:4px;top:5px;width:7px;height:7px;border-radius:50%;background:var(--bg-panel);border:1.5px solid var(--rule);box-sizing:border-box" aria-hidden="true"></span><div style="display:flex;gap:var(--space-2);align-items:baseline;margin-bottom:3px"><span style="font-family:var(--font-mono);font-size:var(--fs-label-l);color:var(--ink-mute);letter-spacing:0.06em">28.ABR</span><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">NAHB</span></div><p style="margin:0;font-family:var(--font-serif);font-size:0.8125rem;line-height:1.5;color:var(--ink)">HMI sobe 3 pts para 47.</p></li></ol></div>"`;
