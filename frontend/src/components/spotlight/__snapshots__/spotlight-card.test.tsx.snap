exports[`SpotlightCard > NAHB-like (group sentimento, fmtSpec num decimals 0) 1`] = `"<section style="background:var(--bg-panel);border:var(--border-card);padding:var(--space-8)" aria-labelledby="spotlight-card-nahb-title"><div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:var(--space-5);gap:var(--space-6);flex-wrap:wrap"><div><div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-2)"><span style="width:8px;height:8px;display:inline-block;background:var(--group-sentimento)" aria-hidden="true"></span><span style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:var(--ls-label);color:var(--ink-mute);text-transform:uppercase">Sentimento &amp; Atividade · indicador em foco</span></div><h2 id="spotlight-card-nahb-title" style="font-family:var(--font-serif);font-size:var(--fs-section);font-weight:400;letter-spacing:var(--ls-section);margin:var(--space-1) 0 0">NAHB Housing Market Index</h2></div><div role="tablist" aria-label="Período do gráfico" style="display:flex;gap:var(--space-1)"><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">1M</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">3M</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(-