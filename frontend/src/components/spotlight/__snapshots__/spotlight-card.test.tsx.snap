exports[`SpotlightCard > NAHB-like (group sentimento, fmtSpec num decimals 0) 1`] = `"<section style="background:var(--bg-panel);border:var(--border-card);padding:var(--space-8)" aria-labelledby="spotlight-card-nahb-title"><div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:var(--space-5);gap:var(--space-6);flex-wrap:wrap"><div><div style="display:flex;align-items:center;gap:var(--space-3);margin-bottom:var(--space-2)"><span style="width:8px;height:8px;display:inline-block;background:var(--group-sentimento)" aria-hidden="true"></span><span style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:var(--ls-label);color:var(--ink-mute);text-transform:uppercase">Sentimento &amp; Atividade · indicador em foco</span></div><h2 id="spotlight-card-nahb-title" style="font-family:var(--font-serif);font-size:var(--fs-section);font-weight:400;letter-spacing:var(--ls-section);margin:var(--space-1) 0 0">NAHB Housing Market Index</h2></div><div role="tablist" aria-label="Período do gráfico" style="display:flex;gap:var(--space-1)"><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">1M</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">3M</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">6M</button><button role="tab" type="button" aria-selected="true" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:var(--bg-band);color:var(--ink-inverse);border:0.5px solid var(--bg-band)">1A</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">5A</button></div></div><div style="display:flex;align-items:baseline;gap:var(--space-5);margin-bottom:var(--space-6);padding-bottom:var(--space-4);border-bottom:var(--border-card);flex-wrap:wrap"><span style="font-family:var(--font-serif);font-size:var(--fs-big);font-weight:400;letter-spacing:var(--ls-big);line-height:1;color:var(--ink)">38</span><span style="font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;line-height:1;color:var(--ink-mute)">±0,0pts<span style="color:var(--ink-mute);margin-left:var(--space-2);font-weight:400">· mês</span></span></div><div style="overflow-x:auto"><svg role="img" aria-label="Série de NAHB Housing Market Index, período 1A" viewBox="0 0 720 240" width="720" height="240" preserveAspectRatio="xMidYMid meet" style="display:block"><line x1="0" y1="218" x2="672" y2="218" stroke="var(--rule-soft)" stroke-width="0.5"></line><line x1="0" y1="163.5" x2="672" y2="163.5" stroke="var(--rule-soft)" stroke-width="0.5"></line><line x1="0" y1="109" x2="672" y2="109" stroke="var(--rule-soft)" stroke-width="0.5"></line><line x1="0" y1="54.5" x2="672" y2="54.5" stroke="var(--rule-soft)" stroke-width="0.5"></line><line x1="0" y1="0" x2="672" y2="0" stroke="var(--rule-soft)" stroke-width="0.5"></line><path d="M 0 87.20000000000002 L 67.2 130.8 L 134.4 43.599999999999994 L 201.60000000000002 0 L 268.8 174.4 L 336 218 L