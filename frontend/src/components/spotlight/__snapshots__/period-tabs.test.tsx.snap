// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PeriodTabs > renderiza 5 pills default com 1A ativo 1`] = `"<div role="tablist" aria-label="Período do gráfico" style="display:flex;gap:var(--space-1)"><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">1M</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">3M</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">6M</button><button role="tab" type="button" aria-selected="true" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:var(--bg-band);color:var(--ink-inverse);border:0.5px solid var(--bg-band)">1A</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">5A</button></div>"`;

exports[`PeriodTabs > respeita options customizadas 1`] = `"<div role="tablist" aria-label="Período do gráfico" style="display:flex;gap:var(--space-1)"><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">3M</button><button role="tab" type="button" aria-selected="true" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:var(--bg-band);color:var(--ink-inverse);border:0.5px solid var(--bg-band)">6M</button><button role="tab" type="button" aria-selected="false" style="font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.06em;padding:4px 10px;cursor:pointer;border-radius:var(--radius-stamp);line-height:1;background:transparent;color:var(--ink-soft);border:0.5px solid var(--rule)">1A</button></div>"`;
