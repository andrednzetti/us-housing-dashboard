// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`QuadroResumido > renderiza section completa com 4 KpiCells em ordem canônica 1`] = `"<section style="background:var(--bg-panel);border:var(--border-card);position:relative" aria-labelledby="quadro-resumido-title"><div style="display:flex;justify-content:space-between;align-items:baseline;padding:var(--space-5) var(--space-7) var(--space-3);border-bottom:var(--border-card);gap:var(--space-4)"><div><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label-l);color:var(--ink-mute);text-transform:uppercase;margin:0">Síntese · Posição em 06.05.2026</div><h2 id="quadro-resumido-title" style="font-family:var(--font-serif);font-size:var(--fs-card);font-weight:500;letter-spacing:var(--ls-card);margin:var(--space-1) 0 0">Quadro resumido da semana</h2></div><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">4 destaques</span></div><div style="display:grid;grid-template-columns:repeat(4, 1fr);border-bottom:var(--border-card)" role="list"><div style="border-right:var(--border-card)" role="listitem"><div style="padding:var(--space-5) var(--space-6);display:flex;flex-direction:column;gap:var(--space-2)" role="group" aria-labelledby="kpi-mortgage30-label"><span id="kpi-mortgage30-label" style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:0.16em;color:var(--ink-mute);text-transform:uppercase;margin:0">Mortgage 30Y Fixa</span><div style="display:flex;align-items:baseline;gap:var(--space-3);flex-wrap:wrap"><span style="font-family:var(--font-serif);font-size:var(--fs-medium);font-weight:400;letter-spacing:var(--ls-medium);line-height:1;color:var(--group-taxas)">+6.30%</span><span style="color:var(--neg);font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;line-height:1">+0.07pp<span style="color:var(--ink-mute);margin-left:var(--space-2);font-weight:400">· sem</span></span></div></div></div><div style="border-right:var(--border-card)" role="listitem"><div style="padding:var(--space-5) var(--space-6);display:flex;flex-direction:column;gap:var(--space-2)" role="group" aria-labelledby="kpi-cs_national-label"><span id="kpi-cs_national-label" style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:0.16em;color:var(--ink-mute);text-transform:uppercase;margin:0">Case-Shiller Nacional</span><div style="display:flex;align-items:baseline;gap:var(--space-3);flex-wrap:wrap"><span style="font-family:var(--font-serif);font-size:var(--fs-medium);font-weight:400;letter-spacing:var(--ls-medium);line-height:1;color:var(--ink)">332,1</span><span style="color:var(--pos);font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;line-height:1">+0.7% a.a.<span style="color:var(--ink-mute);margin-left:var(--space-2);font-weight:400">· 12m</span></span></div></div></div><div style="border-right:var(--border-card)" role="listitem"><div style="padding:var(--space-5) var(--space-6);display:flex;flex-direction:column;gap:var(--space-2)" role="group" aria-labelledby="kpi-months_supply-label"><span id="kpi-months_supply-label" style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:0.16em;color:var(--ink-mute);text-transform:uppercase;margin:0">Months of Supply</span><div style="display:flex;align-items:baseline;gap:var(--space-3);flex-wrap:wrap"><span style="font-family:var(--font-serif);font-size:var(--fs-medium);font-weight:400;letter-spacing:var(--ls-medium);line-height:1;color:var(--ink)">8,5</span><span style="color:var(--pos);font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;line-height:1">-0.6m<span style="color:var(--ink-mute);margin-left:var(--space-2);font-weight:400">· mês</span></span></div></div></div><div style="border-right:none" role="listitem"><div style="padding:var(--space-5) var(--space-6);display:flex;flex-direction:column;gap:var(--space-2)" role="group" aria-labelledby="kpi-nahb-label"><span id="kpi-nahb-label" style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:0.16em;color:var(--ink-mute);text-transform:uppercase;margin:0">NAHB Housing Market Index</span><div style="display:flex;align-items:baseline;gap:var(--space-3);flex-wrap:wrap"><span style="font-family:var(--font-serif);font-size:var(--fs-medium);font-weight:400;letter-spacing:var(--ls-medium);line-height:1;color:var(--ink)">38</span><span style="color:var(--ink-mute);font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;line-height:1">±0.0pts<span style="color:var(--ink-mute);margin-left:var(--space-2);font-weight:400">· mês</span></span></div></div></div></div><div style="padding:var(--space-3) var(--space-7);background:var(--rule-soft);font-family:var(--font-mono);font-size:var(--fs-label-l);letter-spacing:0.1em;color:var(--ink-soft);text-transform:uppercase;display:flex;justify-content:space-between;align-items:center;gap:var(--space-4);flex-wrap:wrap"><span>Demanda em recuperação · construtores otimistas · oferta apertada</span><span>Próxima atualização · 12.MAI.2026 · 14h00 UTC</span></div></section>"`;
