exports[`KpiCell > renderiza Case-Shiller-like (% a.a., 12m, delta positivo neutral upIsBad=false → verde) 1`] = `"<div style="padding:var(--space-5) var(--space-6);display:flex;flex-direction:column;gap:var(--space-2)" role="group" aria-labelledby="kpi-cs_national-label"><span id="kpi-cs_national-label" style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:0.16em;color:var(--ink-mute);text-transform:uppercase;margin:0">Case-Shiller Nacional</span><div style="display:flex;align-items:baseline;gap:var(--space-3);flex-wrap:wrap"><span style="font-family:var(--font-serif);font-size:var(--fs-medium);font-weight:400;letter-spacing:var(--ls-medium);line-height:1;color:var(--ink)">332,1</span><span style="color:var(--pos);font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;line-height:1">+0,66% a.a.<span style="color:var(--ink-mute);margin-left:var(--space-2);font-weight:400">· 12m</span></span></div></div>"`;

exports[`KpiCell > renderiza Months of Supply-like (delta negativo, upIsBad=true → verde) 1`] = `"<div style="padding:var(--space-5) var(--space-6);display:flex;flex-direction:column;gap:var(--space-2)" role="group" aria-labelledby="kpi-months_supply-label"><span id="kpi-months_supply-label" style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:0.16em;color:var(--ink-mute);text-transform:uppercase;margin:0">Months of Supply</span><div style="display:flex;align-items:baseline;gap:var(--space-3);flex-wrap:wrap"><span style="font-family:var(--font-serif);font-size:var(--fs-medium);font-weight:400;letter-spacing:var(--ls-medium);line-height:1;color:var(--ink)">8,5</span><span style="color:var(--pos);font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;line-height:1">−0,6m<span style="color:var(--ink-mute);margin-left:var(--space-2);font-weight:400">· mês</span></span></div></div>"`;

exports[`KpiCell > renderiza Mortgage30-like (delta positivo, upIsBad=true → vermelho) 1`] = `"<div style="padding:var(--space-5) var(--space-6);display:flex;flex-direction:column;gap:var(--space-2)" role="group" aria-labelledby="kpi-mortgage30-label"><span id="kpi-mortgage30-label" style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:0.16em;color:var(--ink-mute);text-transform:uppercase;margin:0">Mortgage 30Y Fixa</span><div style="display:flex;align-items:baseline;gap:var(--space-3);flex-wrap:wrap"><span style="font-family:var(--font-serif);font-size:var(--fs-medium);font-weight:400;letter-spacing:var(--ls-medium);line-height:1;color:var(--group-taxas)">6,30%</span><span style="color:var(--neg);font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;line-height:1">+0,07pp<span style="color:var(--ink-mute);margin-left:var(--space-2);font-weight:400">· sem</span></span></div></div>"`;

exports[`KpiCell > renderiza NAHB-like com delta zero (símbolo ±, cor neutral) 1`] = `"<div style="padding:var(--space-5) var(--space-6);display:flex;flex-direction:column;gap:var(--space-2)" role="group" aria-labelledby="kpi-nahb-label"><span id="kpi-nahb-label" style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:0.16em;color:var(--ink-mute);text-transform:uppercase;margin:0">NAHB Housing Market Index</span><div style="display:flex;align-items:baseline;gap:var(--space-3);flex-wrap:wrap"><span style="font-family:var(--font-serif);font-size:var(--fs-medium);font-weight:400;letter-spacing:var(--ls-medium);line-height:1;color:var(--ink)">38</span><span style="color:var(--ink-mute);font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;line-height:1">±0,0pts<span style="color:var(--ink-mute);margin-left:var(--space-2);font-weight:400">· mês</span></span></div></div>"`;

exports[`KpiCell > respeita valueColor customizado (destaque visual) 1`] = `"<div style="padding:var(--space-5) var(--space-6);display:flex;flex-direction:column;gap:var(--space-2)" role="group" aria-labelledby="kpi-highlighted-label"><span id="kpi-highlighted-label" style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:0.16em;color:var(--ink-mute);text-transform:uppercase;margin:0">Mock Indicator</span><div style="display:flex;align-items:baseline;gap:var(--space-3);flex-wrap:wrap"><span style="font-family:var(--font-serif);font-size:var(--fs-medium);font-weight:400;letter-spacing:var(--ls-medium);line-height:1;color:var(--accent)">99,90%</span><span style="color:var(--pos);font-family:var(--font-mono);font-size:0.6875rem;font-weight:500;line-height:1">+0,12pp<span style="color:var(--ink-mute);margin-left:var(--space-2);font-weight:400">· sem</span></span></div></div>"`;
