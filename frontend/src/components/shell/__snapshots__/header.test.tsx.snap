// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Header > formata dezembro corretamente (DEZ) 1`] = `"<header style="background:var(--bg-band);color:var(--ink-inverse);padding:var(--space-8) var(--space-12) var(--space-7);position:relative"><div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg, var(--accent) 0%, var(--accent) 35%, transparent 100%)" aria-hidden="true"></div><div style="display:grid;grid-template-columns:1fr auto;gap:var(--space-8);align-items:flex-start;margin-bottom:var(--space-7)"><div style="display:flex;flex-direction:column;gap:3px;line-height:1" aria-label="Dissenha Moulding"><span style="font-family:var(--font-sans);font-size:20.16px;font-weight:700;letter-spacing:0.08em;color:var(--accent);text-transform:uppercase;line-height:1" aria-hidden="true">Dissenha</span><span style="font-family:var(--font-sans);font-size:20.16px;font-weight:700;letter-spacing:0.08em;color:var(--accent);text-transform:uppercase;line-height:1" aria-hidden="true">Moulding</span></div><div style="text-align:right"><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);color:rgba(232, 230, 224, 0.55);text-transform:uppercase">Boletim · Nº 48 / Vol. 06</div><div style="font-family:var(--font-mono);font-size:0.6875rem;color:var(--accent);margin-top:var(--space-1);letter-spacing:var(--ls-wordmk)">22 · DEZ · 2026</div></div></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-12);padding-top:var(--space-6);border-top:0.5px solid rgba(184, 137, 58, 0.35)"><div><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label-l);color:var(--accent);text-transform:uppercase;margin-bottom:var(--space-3)">Boletim Semanal</div><h1 style="font-family:var(--font-serif);font-size:var(--fs-hero);font-weight:400;letter-spacing:var(--ls-hero);line-height:var(--lh-hero);margin:0">Mercado Imobiliário<br/><em style="font-style:italic;color:var(--accent);font-weight:400">dos Estados Unidos</em></h1></div><div><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label-l);color:var(--accent);text-transform:uppercase;margin-bottom:var(--space-3)">Destinatário</div><p style="font-family:var(--font-serif);font-size:var(--fs-body);font-style:italic;line-height:var(--lh-editorial);color:rgba(232, 230, 224, 0.85);margin:0">Investidores brasileiros em real estate americano. Compilação semanal de 23 indicadores oficiais — FRED, Realtor.com, NAHB, NMHC, BLS e Census Bureau.</p><div style="display:flex;gap:var(--space-2);margin-top:var(--space-4)"><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:var(--accent);border:0.75px solid var(--accent);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">Confidencial</span><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;color:rgba(232, 230, 224, 0.5);border:0.75px solid rgba(232, 230, 224, 0.5);padding:3px 8px;border-radius:var(--radius-stamp);background:transparent;display:inline-block;line-height:1.2">Atualizado · Ter</span></div></div></div></header>"`;

