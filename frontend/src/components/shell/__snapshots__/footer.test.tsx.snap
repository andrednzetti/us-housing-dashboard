// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Footer > formata timestamp completo dd/mm/yyyy · hh:mm UTC 1`] = `"<footer style="background:var(--bg-band);color:var(--ink-inverse);padding:var(--space-7) var(--space-12) var(--space-6);position:relative"><div style="position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg, transparent 0%, var(--accent) 50%, transparent 100%)" aria-hidden="true"></div><div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:var(--space-8);margin-bottom:var(--space-6)"><div><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label-l);color:var(--accent);text-transform:uppercase;margin-bottom:var(--space-2)">Emissor</div><p style="font-family:var(--font-serif);font-size:0.8125rem;line-height:var(--lh-editorial);color:rgba(232, 230, 224, 0.85);margin:0">Dissenha Moulding Ltda<br/>União da Vitória · PR · Brasil<br/>Análise Macro · 2026</p></div><div><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label-l);color:var(--accent);text-transform:uppercase;margin-bottom:var(--space-2)">Fontes</div><p style="font-family:var(--font-mono);font-size:var(--fs-label-l);line-height:var(--lh-relaxed);color:rgba(232, 230, 224, 0.7);letter-spacing:0.05em;text-transform:uppercase;margin:0">FRED · Realtor.com · NAHB<br/>NMHC · BLS · Census Bureau</p></div><div><div style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label-l);color:var(--accent);text-transform:uppercase;margin-bottom:var(--space-2)">Cadência</div><p style="font-family:var(--font-mono);font-size:var(--fs-label-l);line-height:var(--lh-relaxed);color:rgba(232, 230, 224, 0.7);letter-spacing:0.05em;text-transform:uppercase;margin:0">Atualização semanal · Ter<br/>22/12/2026 · 03:07 UTC<br/>Schema v2.0 · andrednzetti/us-housing-dashboard</p></div></div><div style="padding-top:var(--space-4);border-top:0.5px solid rgba(184, 137, 58, 0.3);display:flex;justify-content:space-between;align-items:center;gap:var(--space-4)"><span style="font-family:var(--font-mono);font-size:var(--fs-label);letter-spacing:var(--ls-label);color:rgba(232, 230, 224, 0.5);text-transform:uppercase">Documento gerado automaticamente · Não constitui recomendação de investimento.</span><svg role="presentation" width="28" height="28" viewBox="0 0 100 100" style="display:block"><path d="M 8 38 L 30 34 L 26 50 L 4 54 Z" fill="var(--accent)"></path><path d="M 4 54 L 26 50 L 22 60 L 8 62 Z" fill="var(--accent)" fill-opacity="0.75"></path><path d="M 92 38 L 70 34 L 74 50 L 96 54 Z" fill="var(--accent)"></path><path d="M 96 54 L 74 50 L 78 60 L 92 62 Z" fill="var(--accent)" fill-opacity="0.75"></path><rect x="46" y="18" width="8" height="46" fill="var(--accent)"></rect><path d="M 34 64 L 50 50 L 66 64 L 60 70 L 50 60 L 40 70 Z" fill="var(--accent)"></path></svg></div></footer>"`;

