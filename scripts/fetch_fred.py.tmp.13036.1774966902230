FRED_BASE_URL = "https://api.stlouisfed.org/fred/series/observations"
OBSERVATION_START = "2020-01-01"
MAX_RETRIES = 3
RETRY_WAITS = [2, 4, 8]
REQUEST_DELAY = 0.3  # seconds between API calls


def fetch_series(series_id: str, api_key: str) -> list[dict] | None:
    """Fetch observations for a single FRED series with retry logic."""
    params = {
        "series_id": series_id,
        "api_key": api_key,
        "file_type": "json",
        "observation_start": OBSERVATION_START,
        "sort_order": "asc",
    }

    for attempt in range(MAX_RETRIES):
        try:
            resp = requests.get(FRED_BASE_URL, params=params, timeout=30)
            resp.raise_for_status()
            data = resp.json()
            observations = data.get("observations", [])
            # Filter out missing values (FRED uses "." for N/A)
            valid = []
            for obs in observations:
                if obs["value"] != ".":
                    try:
                        valid.append({
                            "date": obs["date"],
                            "value": float(obs["value"]),
                        })
                    except (ValueError, TypeError):
                        continue
            return valid
        except requests.RequestException as e:
            if attempt < MAX_RETRIES - 1:
                wait = RETRY_WAITS[attempt]
                print(f"  [RETRY] {series_id} attempt {attempt+1} failed: {e}. "
                      f"Waiting {wait}s...")
                time.sleep(wait)
            else:
                print(f"  [ERROR] {series_id} failed after {MAX_RETRIES} attempts: {e}")
                return None


def compute_changes(observations: list[dict], frequency: str) -> dict:
    """Compute latest value, MoM change, and YoY change."""
    result = {
        "latest_value": None,
        "latest_date": None,
        "yoy_change": None,
        "mom_change": None,
    }
    if not observations:
        return result

    result["latest_value"] = observations[-1]["value"]
    result["latest_date"] = observations[-1]["date"]

    # MoM: compare with the immediately preceding observation
    if len(observations) >= 2:
        prev = observations[-2]["value"]
        curr = observations[-1]["value"]
        if prev and prev != 0:
            result["mom_change"] = round((curr - prev) / abs(prev) * 100, 2)

    # YoY: compare with observation ~12 months ago (or 4 periods for quarterly)
    lookback = 4 if frequency == "Quarterly" else 12
    # For weekly data, ~52 weeks = 1 year
    if frequency == "Weekly":
        lookback = 52

    latest_date = datetime.strptime(observations[-1]["date"], "%Y-%m-%d")
    target_date = latest_date - timedelta(days=365)

    # Find the observation closest to target_date
    best_idx = None
    best_diff = None
    for i, obs in enumerate(observations):
        obs_date = datetime.strptime(obs["date"], "%Y-%m-%d")
        diff = abs((obs_date - target_date).days)
        if best_diff is None or diff < best_diff:
            best_diff = diff
            best_idx = i

    if best_idx is not None and best_diff <= 60:  # within ~2 months tolerance
        yoy_prev = observations[best_idx]["value"]
        curr = observations[-1]["value"]
        if yoy_prev and yoy_prev != 0:
            result["yoy_change"] = round((curr - yoy_prev) / abs(yoy_prev) * 100, 2)

    return result


def main():
    api_key = os.environ.get("FRED_API_KEY")
    if not api_key:
        print("[FATAL] FRED_API_KEY environment variable is not set.")
        sys.exit(1)

    output = {}
    ok_count = 0
    error_count = 0

    print(f"Fetching {len(SERIES)} series from FRED API...")
    print(f"Observation start: {OBSERVATION_START}\n")

    for key, meta in SERIES.items():
        print(f"  Fetching {key} ({meta['name']})...", end=" ")
        observations = fetch_series(meta["id"], api_key)

        if observations is not None:
            changes = compute_changes(observations, meta["frequency"])
            output[key] = {
                **meta,
                "observations": observations,
                **changes,
            }
            print(f"OK — {len(observations)} obs, "
                  f"latest: {changes['latest_value']} ({changes['latest_date']})")
            ok_count += 1
        else:
            error_count += 1
            print("FAILED")

        time.sleep(REQUEST_DELAY)

    # Write intermediate JSON
    out_path = os.path.join(os.path.dirname(__file__), "..", "data", "fred_raw.json")
    out_path = os.path.normpath(out_path)
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(output, f, indent=2, ensure_ascii=False)

    print(f"\n{'='*50}")
    print(f"FRED fetch complete: {ok_count} OK, {error_count} errors")
    print(f"Output: {out_path} ({os.path.getsize(out_path) / 1024:.1f} KB)")

    if error_count > 0:
        print("[WARNING] Some series failed. Check logs above.")
        sys.exit(1 if error_count == len(SERIES) else 0)


if __name__ == "__main__":
    main()
