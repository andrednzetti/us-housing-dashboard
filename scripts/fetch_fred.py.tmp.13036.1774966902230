#!/usr/bin/env python3
"""
Fetch housing market indicators from the FRED API (Federal Reserve of St. Louis).

Retrieves ~15 economic time series, computes YoY/MoM changes,
and writes data/fred_raw.json as an intermediate file.
"""

import json
import os
import sys
import time
from datetime import datetime, timedelta

import requests

# ---------------------------------------------------------------------------
# Series definitions — each entry maps a short key to its FRED metadata.
# ---------------------------------------------------------------------------
SERIES = {
    # Group 1 — Rates & Financing
    "MORTGAGE30US": {
        "id": "MORTGAGE30US",
